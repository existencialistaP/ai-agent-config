{
  "$schema": "https://opencode.ai/config.json",

  // Modelo principal + modelo "pequeno" (title/compaction).
  // Ajuste aqui se a equipe usar outro provider/modelo.
  "model": "opencode-go/deepseek-v4-pro",
  "small_model": "opencode-go/deepseek-v4.1-flash",

  // Superpowers = motor do SDD. Instalado como plugin git, então todos ficam
  // na mesma versão e recebem update pelo plugin manager. Para fixar versão:
  //   "superpowers@git+https://github.com/obra/superpowers.git#v6.3.0"
  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],

  // O comando/skill /context lê e escreve os mapas de contexto do projeto em
  // ~/.config/opencode/contexts/ (por desenvolvedor, não versionado aqui).
  "permission": {
    "read": { "~/.config/opencode/contexts/**": "allow" },
    "edit": { "~/.config/opencode/contexts/**": "allow" },
    "external_directory": { "~/.config/opencode/contexts/**": "allow" }
  }
}
